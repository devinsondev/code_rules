{
  "manifest_version": 3,
  "name": "Cross-browser MV3 Starter",
  "version": "0.1.0",
  "description": "Permissionless Chrome and Firefox WebExtension example.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "replace-me@example.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
